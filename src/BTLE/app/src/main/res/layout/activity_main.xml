<?xml version="1.0" encoding="utf-8"?>
<!--
    Antes este layout sólo tenía los dos botones del servicio (MainActivityServicio) y las
    otras dos Activities no podían ni inflarlo. Ahora es el layout ÚNICO de MainActivity y
    tiene un botón por cada manejador android:onClick.
-->
<!-- Sin ScrollView los 9 botones no caben en pantalla y los ultimos son
     imposibles de pulsar. El ScrollView permite llegar a todos. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <android.widget.LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        tools:context=".MainActivity">

    <TextView
        android:id="@+id/estado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Servicio parado."
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- ================= ESCANEO BTLE ================= -->

    <Button
        android:id="@+id/botonBuscarDispositivos"
        android:text="Buscar TODOS los dispositivos BTLE"
        android:onClick="botonBuscarDispositivosBTLEPulsado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <Button
        android:id="@+id/botonBuscarNuestroDispositivo"
        android:text="Buscar NUESTRO dispositivo (GTI-3A-Jose)"
        android:onClick="botonBuscarNuestroDispositivoBTLEPulsado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <Button
        android:id="@+id/botonDetenerBusquedaDispositivos"
        android:text="Detener búsqueda BTLE"
        android:onClick="botonDetenerBusquedaDispositivosBTLEPulsado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- ================= SERVICIO ================= -->

    <Button
        android:id="@+id/botonArrancarServicio"
        android:text="Arrancar Servicio"
        android:onClick="botonArrancarServicioPulsado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <Button
        android:id="@+id/botonDetenerServicio"
        android:text="Detener Servicio"
        android:onClick="botonDetenerServicioPulsado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- ================= MEDIDA AL SERVIDOR REST ================= -->

    <Button
        android:id="@+id/botonSimularBeacon"
        android:text="Simular recepción de Beacon (CO2)"
        android:onClick="botonSimularBeaconPulsado"
        android:backgroundTint="#FF9800"
        android:textColor="#FFFFFF"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />


    <Button
        android:id="@+id/botonTestEnviarMedida"
        android:text="TEST AUTOMÁTICO: enviar medida al servidor"
        android:onClick="botonTestEnviarMedidaPulsado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- ================= PRUEBAS DEL CLIENTE REST ================= -->

    <Button
        android:id="@+id/botonPruebaPOST"
        android:text="Prueba REST: POST a httpbin.org"
        android:onClick="botonPruebaPOSTPulsado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <Button
        android:id="@+id/botonPruebaGET"
        android:text="Prueba REST: GET a jsonplaceholder"
        android:onClick="botonPruebaGETPulsado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <Button
        android:id="@+id/botonPruebaGET2"
        android:text="Prueba REST: GET a reqbin"
        android:onClick="botonPruebaGET2Pulsado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/ultimaMedicion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="(aún no se ha recibido ninguna medida)"
        android:textSize="14sp" />

    </android.widget.LinearLayout>
</ScrollView>
